#include <winver.h>
#include "../access/version.h"

IDI_MAINICON            ICON    DISCARDABLE     "win-mainicon.ico"

// the file information Windows shows (Task Manager, volume mixer, firewall, file properties):
// without it, Windows falls back to the file name
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    JAMULUSACCESS_VERSION_MAJOR, JAMULUSACCESS_VERSION_MINOR, 0, 0
 PRODUCTVERSION JAMULUSACCESS_VERSION_MAJOR, JAMULUSACCESS_VERSION_MINOR, 0, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ReaperAccessible"
            VALUE "FileDescription",  "JamulusAccess"
            VALUE "FileVersion",      JAMULUSACCESS_VERSION
            VALUE "InternalName",     "JamulusAccess"
            VALUE "LegalCopyright",   "The Jamulus Development Team, ReaperAccessible. GNU AGPL 3.0 or later."
            VALUE "OriginalFilename", "JamulusAccess.exe"
            VALUE "ProductName",      "JamulusAccess"
            VALUE "ProductVersion",   JAMULUSACCESS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
